// Esquema de base de datos del Sistema de Gestion de Soportes TI.
//
// Produccion: PostgreSQL en Supabase.
//   DATABASE_URL = connection string agrupada (pooler, puerto 6543) que usa la app en runtime.
//   DIRECT_URL   = connection string directa (puerto 5432) que usa Prisma solo para migraciones.
// Ambas se obtienen en el dashboard de Supabase: Project Settings > Database > Connection string.
//
// Para desarrollo local sin Supabase, cambia provider a "sqlite" y usa DATABASE_URL="file:./dev.db"
// (ver README para el detalle de ambos modos).
//
// Nota: estado, rol y prioridad se guardan como texto (String) en vez de
// enum nativo porque el proyecto tambien puede correr sobre SQLite en
// desarrollo (que no soporta enums nativos). Los valores permitidos se
// validan en la capa de aplicacion (src/lib/ticket.ts y src/lib/validation.ts).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           String   @id @default(cuid())
  nombre       String
  correo       String   @unique
  area         String?
  rol          String   @default("ADMIN") // ADMIN
  passwordHash String
  creadoEn     DateTime @default(now())

  ticketsAtendidos Ticket[] @relation("AdminTickets")
}

model Ticket {
  id                 String    @id @default(cuid())
  codigoTicket       String    @unique
  nombreSolicitante  String
  area               String    // Asesor | Administrativos
  categoria          String
  descripcion        String
  estado             String    @default("PENDIENTE") // PENDIENTE | EN_PROCESO | CERRADO
  prioridad          String    @default("MEDIA")      // BAJA | MEDIA | ALTA

  fechaCreacion      DateTime  @default(now())
  fechaInicio        DateTime?
  fechaCierre        DateTime?

  // tiempos en minutos, calculados al cambiar de estado
  tiempoLlegada      Int?
  tiempoResolucion   Int?
  tiempoTotal        Int?

  solucion           String?

  adminId            String?
  admin              User?     @relation("AdminTickets", fields: [adminId], references: [id])

  creadoEn           DateTime  @default(now())
  actualizadoEn      DateTime  @updatedAt

  @@index([estado])
  @@index([fechaCreacion])
  @@index([fechaCierre])
}
