# Base de datos: SQLite local por defecto (gratis, sin configuracion).
# Para produccion en Supabase, cambia el provider en prisma/schema.prisma a "postgresql"
# y pon aqui la connection string de Supabase (Settings > Database > Connection string).
DATABASE_URL="file:./dev.db"

# Secreto para firmar la sesion del panel admin (cadena larga y aleatoria).
AUTH_SECRET="cambia-este-valor-por-uno-largo-y-aleatorio"

# Credenciales del administrador que crea el script de seed.
ADMIN_EMAIL="admin@empresa.com"
ADMIN_PASSWORD="CambiaEstaClave123"
ADMIN_NOMBRE="Juan Sebastian Nieto Castano"
