# Base de datos: PostgreSQL en Supabase.
# Obten ambas URLs en el dashboard de Supabase: Project Settings > Database > Connection string.
#   DATABASE_URL -> "Transaction pooler" (puerto 6543). La usa la app en runtime.
#   DIRECT_URL   -> "Direct connection" (puerto 5432). La usa Prisma solo para migraciones.
DATABASE_URL="postgresql://postgres.xxxxx:TU-PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.xxxxx:TU-PASSWORD@aws-0-region.pooler.supabase.com:5432/postgres"

# Para desarrollo local sin Supabase, puedes usar SQLite en su lugar:
#   1) prisma/schema.prisma -> datasource db { provider = "sqlite" url = env("DATABASE_URL") }
#      (quita la linea directUrl, SQLite no la necesita)
#   2) DATABASE_URL="file:./dev.db"

# Secreto para firmar la sesion del panel admin (cadena larga y aleatoria).
AUTH_SECRET="cambia-este-valor-por-uno-largo-y-aleatorio"

# Cuentas que siembra `npm run seed`. Hay dos perfiles:
#
#   ADMIN   -> lider de TI. Entra por /admin. Borra tickets, gestiona cuentas
#              y lee la bitacora de actividad.
#   SOPORTE -> quien atiende. Entra por /soporte. Atiende y consulta, no borra.
#
# Las contrasenas viven SOLO aqui, nunca en el codigo: el seed aborta si
# faltan, en vez de caer a un valor por defecto que terminaria publicado en
# el repositorio. Minimo 8 caracteres.
#
# ADMIN_EMAIL es solo el nombre de usuario para iniciar sesion (no tiene que
# ser un correo real). El de soporte si, porque ahi se validan como correo.
ADMIN_EMAIL="admin"
ADMIN_PASSWORD="define-una-contrasena-fuerte"
ADMIN_NOMBRE="Juan Sebastian Nieto Castano"

# La cuenta de soporte es opcional en el seed: si no defines SOPORTE_PASSWORD
# no se crea, y despues puedes crearla desde el panel del lider de TI.
SOPORTE_EMAIL="soporte@voz360.co"
SOPORTE_PASSWORD="define-una-contrasena-fuerte"
SOPORTE_NOMBRE="Mateo Echeverry"
